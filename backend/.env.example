# Canvas AI Assistant Backend Configuration
# Copy this file to .env and configure your settings

# Server Configuration
PORT=3000
NODE_ENV=development

# ============================================================
# 🔑 CANVAS LMS OAuth (get from Canvas Admin → Developer Keys)
# ============================================================
CANVAS_CLIENT_ID=your_canvas_client_id_here
CANVAS_CLIENT_SECRET=your_canvas_client_secret_here

# ============================================================
# 🔑 BLACKBAUD SKY API OAuth (get from Blackbaud Developer Portal)
# ============================================================
BLACKBAUD_CLIENT_ID=your_blackbaud_client_id_here
BLACKBAUD_CLIENT_SECRET=your_blackbaud_client_secret_here

# ============================================================
# 🔑 SERPER API (for web search)
# ============================================================
SERPER_API_KEY=your_serper_api_key_here

# ============================================================
# 🔑 EMAILJS API (for email notifications)
# ============================================================
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# ============================================================
# 🔑 GEMINI API (for AI chat)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Security
ALLOWED_ORIGINS=chrome-extension://your_extension_id_here,https://your_deployed_app_url_here
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info