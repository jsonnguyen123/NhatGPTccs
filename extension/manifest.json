{
  "manifest_version": 3,
  "name": "Canvas AI Assistant",
  "key": "",
  "version": "1.0.0",
  "description": "AI-powered assistant for Canvas LMS - organize assignments, track grades, and manage your academic workflow",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting", 
    "notifications",
    "identity"
  ],
  
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.instructure.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://canvas-ai-assistant-production.up.railway.app/*",
    "https://api.sky.blackbaud.com/*",
    "https://app.blackbaud.com/",
    "https://christchurchschool.myschoolapp.com/",
    "https://www.sagedining.com/*",
    "https://formsubmit.co/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },

  "oauth2": {
    "client_id": "881288556408-5obnh1f8990olbp25mos9j2jreiu2h70.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }, 
  
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*"],
      "js": [
        "agent_config.js",      
        "trimester_utils.js",
        "canvas_tools.js",            
        "agent_manager.js",     
        "auth.js",                                 
        "chatbot.js",
        "content.js"              
      ],
      "css": ["chatbot.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas AI Assistant",
    "default_icon": {
      "16": "icon16.png",
      "32": "school-logo-wbg.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  
  "options_page": "options-enhanced.html",
  
  "icons": {
    "16": "icon16.png",
    "32": "school-logo-wbg.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  
  "web_accessible_resources": [
  {
    "resources": [
        "chatbot.html",
        "chatbot.css",
        "content-styles.css",
        "final-school-logo.png"
    ],
    "matches": ["https://*.instructure.com/*"]
  }
]
}
